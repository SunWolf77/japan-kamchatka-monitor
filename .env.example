# Optional — only if enabling Better Auth / OAuth in production
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://your-deployment.vercel.app
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Public app URL (Vercel sets VERCEL_URL automatically)
# SITE_URL=https://your-deployment.vercel.app
# Generate: openssl rand -hex 32
# REQUIRED on Vercel Production for /api/cron (must match GitHub Actions secret)
# Generate: openssl rand -hex 32
# Production fails closed (503) when unset.
# CRON_SECRET=
