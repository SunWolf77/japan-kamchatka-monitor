# Optional — only if enabling Better Auth / OAuth in production
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://your-deployment.vercel.app
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Public app URL (Vercel sets VERCEL_URL automatically)
# SITE_URL=https://your-deployment.vercel.app
# Vercel Cron / GitHub Actions — when set, /api/cron requires Authorization: Bearer <CRON_SECRET>
# Generate: openssl rand -hex 32
# CRON_SECRET=
